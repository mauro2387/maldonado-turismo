# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=maldonado_user
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=maldonado_turismo
DATABASE_SSL=false

# API Configuration
API_PORT=3000
API_PREFIX=api/v1
API_CORS_ORIGIN=http://localhost:5173

# Storage Configuration (MinIO / S3)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=maldonado-files
STORAGE_USE_SSL=false

# Map Configuration
MAPBOX_TOKEN=your_mapbox_token_here

# GPS en tiempo real (feeds AVL de las empresas de ómnibus)
# Su uso en producción requiere acuerdo con CODESA y Maldonado Turismo.
GPS_FEEDS_ENABLED=true
GPS_FEED_CODESA_URL=http://ip.codesa.com.uy/pub/avl.xml
GPS_FEED_MALDONADO_TURISMO_URL=http://microltda.ddns.net:32495/pub/avl.xml
GPS_FEED_MICRO_URL=http://microltda.ddns.net:32496/pub/avl.xml
GPS_POLL_INTERVAL_MS=15000
GPS_REQUEST_TIMEOUT_MS=10000
GPS_RETENTION_HOURS=24

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_VERLYX=false

# Environment
NODE_ENV=development

# Ingesta diaria de la agenda de eventos (agendas públicas de la IDM, prensa
# local y portal de turismo). Ver src/modules/agenda/scraper/.
EVENTS_SCRAPER_ENABLED=true
# Hora local de Uruguay a la que corre la tarea diaria.
EVENTS_SCRAPER_HOUR=5
# Por debajo de esta confianza en la fecha, el evento queda pendiente de
# revisión en el backoffice en vez de publicarse solo.
EVENTS_SCRAPER_MIN_CONFIDENCE=0.75

# Supabase Storage: de acá se sirven las fotos de los atractivos turísticos.
# La service key es de administración y no va nunca al frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Reconstrucción del catálogo de paradas desde el feed AVL de las empresas.
# El XML publica la parada por la que acaba de pasar cada coche (código y
# nombre); la coordenada se deduce de las posiciones. Corre a diario de
# madrugada y se puede forzar con POST /transport/stops/rebuild-catalog.
STOP_CATALOG_ENABLED=true
STOP_CATALOG_HOUR=4

# Recorridos de las líneas
#
# El trazo de cada línea sale de lo que publica la empresa: CODESA, Maldonado
# Turismo y Micro tienen sus recorridos dibujados en Google My Maps y se bajan
# en KML. Se importan con
#
#   npx ts-node src/scripts/import-official-routes.ts
#   npx ts-node src/scripts/match-official-routes.ts   # cuál hace cada coche
#   npx ts-node src/scripts/place-stops.ts             # paradas sobre el trazo
#
# El emparejamiento vuelve a correr solo cada ROUTE_SHAPES_BUILD_INTERVAL_MS.
# La importación es manual: los recorridos cambian pocas veces al año, y
# conviene mirar el resultado antes de publicarlo.
ROUTE_SHAPES_ENABLED=true
ROUTE_SHAPES_BUILD_INTERVAL_MS=21600000
ROUTE_SHAPES_LOOKBACK_HOURS=24

# Motor de ruteo. Se usa para las líneas que la empresa no publica -ahí el
# recorrido se reconstruye con el GPS- y para dibujar las caminatas del
# planificador.
#
# El servidor público sirve para desarrollo, pero su política de uso no
# contempla producción: hay que levantar OSRM propio con un extracto de
# Uruguay y apuntar acá.
OSRM_BASE_URL=https://router.project-osrm.org
# El perfil peatonal sólo existe si se compiló OSRM con él. El servidor
# público responde lo mismo para /foot que para /driving (la ruta del auto),
# así que por defecto queda apagado y el tiempo de caminata se calcula por
# distancia.
OSRM_FOOT_PROFILE=false

# Lugares con nombre para buscar destinos ("punta shopping", "el hospital").
# Se importan de OpenStreetMap y se guardan en geo_places:
#
#   npx ts-node src/scripts/import-osm-places.ts

# Dónde para el ómnibus
#
# La coordenada de cada parada se mide, no se carga: cuando un coche informa
# que acaba de pasar la parada X y además está detenido, ese punto es la
# parada. `vehicle_positions` se poda a las 24 h, así que esos avistamientos se
# guardan aparte en `stop_observations` y la precisión mejora sola con los días
# sin que nadie corra nada.
#
# Medido contra los nodos relevados de OpenStreetMap el 2026-09-04: el
# estimador viejo (interpolar entre dos posiciones) daba 57 m de error mediano;
# éste da 15 m.
STOP_OBSERVATIONS_ENABLED=true
STOP_OBSERVATIONS_INTERVAL_MS=3600000

# La segunda opinión sobre dónde está cada parada, y la única verdad de campo
# que hay para calibrar. Se importa a mano, cambia poco:
#
#   npx ts-node src/scripts/import-osm-stops.ts
#
# Después, para que la coordenada llegue al catálogo:
#   POST /transport/stops/place
#
# Y para ver si mejoró o empeoró:
#   GET  /transport/stops/quality
