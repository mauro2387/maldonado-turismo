# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------

# Cadena de conexión completa a PostgreSQL. Es la que usa la aplicación.
DATABASE_URL=
# TLS. Las bases gestionadas (Supabase, Neon, RDS) lo exigen; una Postgres
# local no lo tiene habilitado y rechaza la conexión si se lo pedimos.
DATABASE_SSL=true
# Log de todas las consultas. Queda apagado porque la ingesta GPS escribe
# decenas de filas cada pocos segundos y tapa cualquier otra cosa.
DATABASE_LOGGING=false

# Los scripts sueltos de src/scripts/ conectan con estos campos por separado
# en lugar de con DATABASE_URL.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

API_PORT=3000
API_PREFIX=api/v1
# Orígenes permitidos por CORS, separados por coma.
API_CORS_ORIGIN=http://localhost:5173
# Documentación OpenAPI en /api/v1/docs.
ENABLE_SWAGGER=true
NODE_ENV=development

# ---------------------------------------------------------------------------
# Autenticación del backoffice
# ---------------------------------------------------------------------------

# Clave de firma de los JWT. Generar una cadena larga y aleatoria por entorno.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Feeds GPS de las empresas de ómnibus
# ---------------------------------------------------------------------------
#
# Cada empresa publica un XML AVL con la posición de sus coches. Las URLs no
# viajan en el repositorio: son infraestructura de las empresas y su uso
# requiere acuerdo con cada una. El feed que quede sin URL no se consulta.

GPS_FEEDS_ENABLED=true
GPS_FEED_CODESA_URL=
GPS_FEED_MALDONADO_TURISMO_URL=
GPS_FEED_MICRO_URL=
# Cada cuánto se consulta cada feed.
GPS_POLL_INTERVAL_MS=15000
GPS_REQUEST_TIMEOUT_MS=10000
# Pasado este tiempo sin reportar, un coche deja de considerarse en la calle.
GPS_FEED_STALE_MINUTES=30
# Las posiciones se podan a esta antigüedad. La tabla crece rápido.
GPS_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# Recorridos de las líneas
# ---------------------------------------------------------------------------
#
# El trazo de cada línea sale de lo que publica la empresa en Google My Maps y
# se importa en KML; para las que no publican, se reconstruye con el GPS. La
# importación es manual porque los recorridos cambian pocas veces al año:
#
#   npx ts-node src/scripts/import-official-routes.ts
#   npx ts-node src/scripts/match-official-routes.ts
#   npx ts-node src/scripts/place-stops.ts

ROUTE_SHAPES_ENABLED=true
# Cada cuánto se rehace el emparejamiento coche/recorrido.
ROUTE_SHAPES_BUILD_INTERVAL_MS=21600000
ROUTE_SHAPES_LOOKBACK_HOURS=24
# Distancia máxima para pegar una posición al trazo de su línea.
ROUTE_SHAPES_MAX_SNAP_M=60

# ---------------------------------------------------------------------------
# Motor de ruteo
# ---------------------------------------------------------------------------
#
# Se usa para reconstruir recorridos y para dibujar las caminatas del
# planificador. El servidor público sirve para desarrollo, pero su política de
# uso no contempla producción: hay que levantar OSRM propio con un extracto de
# Uruguay y apuntar acá.

OSRM_BASE_URL=https://router.project-osrm.org
# Perfil peatonal. El de auto no sirve para caminatas: manda por la calzada y
# respeta los sentidos únicos.
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# Servicio /match de OSRM para ajustar trazos ruidosos. Cuesta más y sólo vale
# la pena cuando el trazo reconstruido queda sucio.
OSRM_USE_MATCH=false

# ---------------------------------------------------------------------------
# Dónde para el ómnibus
# ---------------------------------------------------------------------------
#
# La coordenada de cada parada se mide, no se carga: cuando un coche informa
# que acaba de pasar la parada X y además está detenido, ese punto es la
# parada. Como las posiciones se podan a las 24 h, esos avistamientos se
# guardan aparte y la precisión mejora sola con los días.

STOP_CATALOG_ENABLED=true
# Hora local a la que se reconstruye el catálogo de paradas desde el feed.
STOP_CATALOG_HOUR=4
STOP_OBSERVATIONS_ENABLED=true
STOP_OBSERVATIONS_INTERVAL_MS=3600000

# ---------------------------------------------------------------------------
# Agenda de eventos
# ---------------------------------------------------------------------------
#
# Ingesta diaria desde las agendas públicas, la prensa local y el portal de
# turismo. Ver src/modules/agenda/scraper/.

EVENTS_SCRAPER_ENABLED=true
# Hora local a la que corre la tarea diaria.
EVENTS_SCRAPER_HOUR=5
# Por debajo de esta confianza en la fecha, el evento queda pendiente de
# revisión en el backoffice en vez de publicarse solo.
EVENTS_SCRAPER_MIN_CONFIDENCE=0.75

# ---------------------------------------------------------------------------
# Almacenamiento de imágenes
# ---------------------------------------------------------------------------
#
# De acá se sirven las fotos de los atractivos turísticos.

SUPABASE_URL=
# Clave de administración. No va nunca al frontend.
SUPABASE_SERVICE_KEY=
